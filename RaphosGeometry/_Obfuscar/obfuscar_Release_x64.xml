     _Obfuscar/generate-obfuscar.ps1 at Release-build time, so the .NET ref pack
     paths track whichever 8.0.x SDK is installed on this machine. -->
<Obfuscator>
  <Var name="InPath" value="bin\x64\Release\" />
  <Var name="OutPath" value="bin\x64\Release\\Out" />
  <Include path="_Obfuscar\obfuscar.generated.xml" />
</Obfuscator>
