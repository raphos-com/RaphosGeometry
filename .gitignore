# Build output
[Bb]in/
[Oo]bj/
x64/
*.user
*.suo
.vs/

# NuGet
*.nupkg
project.assets.json

# Native intermediates (build output lives under x64/ which is already ignored above;
# do NOT blanket-ignore *.obj — the example .obj geometry assets must be tracked)
*.pdb
*.ilk
*.exp
*.lib
*.tlog
*.idb

# Packaged add-in (built artifact)
*.synaddin

# Obfuscar: generated config tracks the machine's .NET ref pack, and Mapping.txt is the
# rename table that would undo the obfuscation. Neither should be committed.
**/_Obfuscar/obfuscar.generated.xml
Mapping.txt
